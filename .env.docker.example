# Copy to .env.docker and fill in real values before `docker compose up`.
# Unlike .env (used for running the app on the host), these use the
# in-network service hostnames (db, redis, elasticsearch) defined in
# docker-compose.yaml, not localhost.

# Application
ENV=DEVELOPMENT
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (also consumed directly by the `db` service for its own init)
POSTGRES_PASSWORD=password
POSTGRES_DB=booking
DB_URL=postgresql+asyncpg://postgres:password@db:5432/booking
TEST_DB_URL=postgresql+asyncpg://postgres:password@db:5432/booking_test

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Elasticsearch
ES_URL=http://elasticsearch:9200

# Email (SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# JWT
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_SECRET_ACCESS_KEY=change_me_access_secret
JWT_SECRET_REFRESH_KEY=change_me_refresh_secret
JWT_ALGORITHM=HS256

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# OMDB API
OMDB_API_KEY=your_omdb_api_key

# Encryption
ENCRYPTION_PASSWORD=your_encryption_password
ENCRYPTION_STATIC_SALT=your_static_salt
