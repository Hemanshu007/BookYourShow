# Application
ENV=DEVELOPMENT
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
DB_URL=postgresql+asyncpg://postgres:password@localhost:5432/booking
TEST_DB_URL=postgresql+asyncpg://postgres:password@localhost:5431/booking_test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Elasticsearch
ES_URL=http://localhost:9200

# Email (SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# JWT
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_SECRET_ACCESS_KEY=your_access_secret_key
JWT_SECRET_REFRESH_KEY=your_refresh_secret_key
JWT_ALGORITHM=HS256

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# OMDB API
OMDB_API_KEY=your_omdb_api_key

# Encryption
ENCRYPTION_PASSWORD=your_encryption_password
ENCRYPTION_STATIC_SALT=your_static_salt
